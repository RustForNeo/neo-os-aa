<Project>
  <PropertyGroup>
    <!--
      UnifiedSmartWallet requires the gas-bounded verifier syscall. Keep the
      platform version explicit so a build cannot silently consume an older
      framework that does not emit System.Contract.CallWithGasLimit.
      The matching package is produced by the sibling Neo/DevPack branches
      during private-chain validation until it is published upstream.
    -->
    <NeoSmartContractFrameworkVersion Condition="'$(NeoSmartContractFrameworkVersion)' == ''">3.10.2-CI00384</NeoSmartContractFrameworkVersion>
  </PropertyGroup>
</Project>
