# === NeoOS Standard .gitignore ===

# Tool State (NEVER commit)
/.claude/
/.codegraph/
/.serena/
/.planning/
/.workbuddy/
/.omx/
/.worktrees/
/graphify-out/
/.vercel/
/.turbo/

# Build Outputs
/target/
/dist/
/coverage/
/.next/
/test-results/
*.neopkg
*.wasm

# .NET build outputs (unanchored to match at any depth)
bin/
obj/

# Dependencies
/node_modules/
node_modules/

# Environment
.env
.env.*
!.env.example

# Secrets
*.pem
*.key
*.p12
id_rsa*
*.gpg

# Editor/IDE
/.vscode/
/.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp
*.log
*.tmp
*.bak
.cache/
/tmp/

# === Repository-Specific Patterns ===

# Test artifacts
tests/.env.testnet
tests/VALIDATION_SUMMARY.md
tests/MIXED_VERIFICATION_PLAN.md
tests/mixed-verification-test.js
tests/run-mixed-verification.js
mainnet-aa-*-results.json

# Automation logs
.automation-logs/

# LaTeX build artifacts
*.aux
*.out
missfont.log
